{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui:dev",
      "type": "shell", "command": "npm", "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(VITE|vite).*",
          "endsPattern": ".*(Local|ready).*"
        }
      }
    },
    { "label": "ui:build", "type": "shell", "command": "npm", "args": ["run", "build"] },
    {
      "label": "sync:version", "type": "shell", "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\sync-version.ps1"]
    },
    {
      "label": "tauri:dev", "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\vsc-task.ps1", "-Cmd", "tauri dev"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "tauri:build", "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\vsc-task.ps1", "-Cmd", "tauri build"],
      "dependsOrder": "sequence",
      "dependsOn": ["sync:version"],
      "problemMatcher": []
    },
    {
      "label": "rust:check", "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\vsc-task.ps1",
               "-Cmd", "clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"],
      "problemMatcher": "$rustc"
    }
  ]
}