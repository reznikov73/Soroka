{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Запуск Сороки (tauri:dev)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\vsc-task.ps1", "-Cmd", "tauri dev"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Отладка: подготовка (сборка + сервер)",
      "detail": "Запускается автоматически перед F5: поднимает dev-сервер и собирает debug-версию",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\debug-prep.ps1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "soroka-debug-prep",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*SOROKA DEBUG READY.*"
        }
      }
    },
    {
      "label": "Сборка Сороки (debug)",
      "detail": "Просто собирает debug-версию (без запуска)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\vsc-task.ps1",
               "-Cmd", "build --no-default-features --manifest-path src-tauri/Cargo.toml"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "Сборка релиза (tauri:build)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\vsc-task.ps1", "-Cmd", "tauri build"],
      "dependsOrder": "sequence",
      "dependsOn": ["Версия: синхронизация (sync:version)"],
      "problemMatcher": []
    },
    {
      "label": "Интерфейс: dev-сервер (ui:dev)",
      "type": "shell", "command": "npm", "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(VITE|vite).*",
          "endsPattern": ".*(Local|ready).*"
        }
      }
    },
    { "label": "Интерфейс: сборка (ui:build)", "type": "shell", "command": "npm", "args": ["run", "build"] },
    {
      "label": "Версия: синхронизация (sync:version)",
      "type": "shell", "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\sync-version.ps1"]
    },
    {
      "label": "Rust: проверка (rust:check)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}\\scripts\\vsc-task.ps1",
               "-Cmd", "clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"],
      "problemMatcher": "$rustc"
    }
  ]
}