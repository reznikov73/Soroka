{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Отладка Сороки (Rust)",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "Интерфейс: dev-сервер (ui:dev)",
      "cargo": {
        "args": ["build", "--manifest-path", "${workspaceFolder}\\src-tauri\\Cargo.toml"]
      },
      "program": "${workspaceFolder}\\src-tauri\\target\\debug\\soroka.exe"
    },
    {
      "name": "Подключиться к Сороке",
      "type": "lldb",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}