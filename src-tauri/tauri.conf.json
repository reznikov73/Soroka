{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soroka",
  "version": "0.28.2",
  "identifier": "com.soroka.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Сорока",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
